// Cloudflare Worker for https://runwithstride.app (the Stride website).
// Deploy: `npx wrangler@4 deploy` from this folder, or Cloudflare Workers Builds
// with root directory `website` (see README.md).
{
  "name": "runwithstride",
  "main": "src/index.js",
  "compatibility_date": "2026-11-01",
  "assets": {
    "directory": "./public",
    "binding": "ASSETS",
    "run_worker_first": true
  },
  "routes": [
    { "pattern": "runwithstride.app", "custom_domain": true },
    { "pattern": "www.runwithstride.app", "custom_domain": true }
  ],
  "observability": { "enabled": true }
}
