DEFINE SCHEMA

    RECORD TYPE CD_DeletedWorkout (
        CD_deletedAt          TIMESTAMP QUERYABLE SORTABLE,
        CD_entityName         STRING QUERYABLE SEARCHABLE SORTABLE,
        CD_healthKitWorkoutID STRING QUERYABLE SEARCHABLE SORTABLE,
        CD_id                 STRING QUERYABLE SEARCHABLE SORTABLE,
        "___createTime"       TIMESTAMP,
        "___createdBy"        REFERENCE,
        "___etag"             STRING,
        "___modTime"          TIMESTAMP,
        "___modifiedBy"       REFERENCE,
        "___recordID"         REFERENCE,
        GRANT WRITE TO "_creator",
        GRANT CREATE TO "_icloud",
        GRANT READ TO "_world"
    );

    RECORD TYPE CD_RunWorkout (
        CD_aiCoachReactionRaw           STRING QUERYABLE SEARCHABLE SORTABLE,
        CD_averageCadenceStepsPerMinute DOUBLE QUERYABLE SORTABLE,
        CD_averageHeartRate             DOUBLE QUERYABLE SORTABLE,
        CD_averagePaceSecondsPerKm      DOUBLE QUERYABLE SORTABLE,
        CD_cachedAIInsightData          BYTES QUERYABLE SORTABLE,
        CD_cachedAIInsightData_ckAsset  ASSET,
        CD_customWorkoutID              STRING QUERYABLE SEARCHABLE SORTABLE,
        CD_customWorkoutName            STRING QUERYABLE SEARCHABLE SORTABLE,
        CD_date                         TIMESTAMP QUERYABLE SORTABLE,
        CD_distanceMeters               DOUBLE QUERYABLE SORTABLE,
        CD_distanceSeriesData           BYTES QUERYABLE SORTABLE,
        CD_distanceSeriesData_ckAsset   ASSET,
        CD_durationSeconds              DOUBLE QUERYABLE SORTABLE,
        CD_elevationGainMeters          DOUBLE QUERYABLE SORTABLE,
        CD_entityName                   STRING QUERYABLE SEARCHABLE SORTABLE,
        CD_feelRaw                      INT64 QUERYABLE SORTABLE,
        CD_healthKitWorkoutID           STRING QUERYABLE SEARCHABLE SORTABLE,
        CD_heartRateSamplesData         BYTES QUERYABLE SORTABLE,
        CD_heartRateSamplesData_ckAsset ASSET,
        CD_id                           STRING QUERYABLE SEARCHABLE SORTABLE,
        CD_lapsData                     BYTES QUERYABLE SORTABLE,
        CD_lapsData_ckAsset             ASSET,
        CD_linkedScheduledWorkoutID     STRING QUERYABLE SEARCHABLE SORTABLE,
        CD_maxHeartRate                 DOUBLE QUERYABLE SORTABLE,
        CD_notes                        STRING QUERYABLE SEARCHABLE SORTABLE,
        CD_routeData                    BYTES QUERYABLE SORTABLE,
        CD_routeData_ckAsset            ASSET,
        CD_scheduledWorkout             STRING QUERYABLE SEARCHABLE SORTABLE,
        CD_shoeID                       STRING QUERYABLE SEARCHABLE SORTABLE,
        CD_splitUnitRaw                 STRING QUERYABLE SEARCHABLE SORTABLE,
        CD_splitsData                   BYTES QUERYABLE SORTABLE,
        CD_splitsData_ckAsset           ASSET,
        CD_weatherData                  BYTES QUERYABLE SORTABLE,
        CD_weatherData_ckAsset          ASSET,
        CD_workoutLocationLegacy        STRING QUERYABLE SEARCHABLE SORTABLE,
        CD_workoutLocationRaw           STRING QUERYABLE SEARCHABLE SORTABLE,
        CD_workoutTypeLegacy            STRING QUERYABLE SEARCHABLE SORTABLE,
        CD_workoutTypeRaw               STRING QUERYABLE SEARCHABLE SORTABLE,
        "___createTime"                 TIMESTAMP,
        "___createdBy"                  REFERENCE,
        "___etag"                       STRING,
        "___modTime"                    TIMESTAMP,
        "___modifiedBy"                 REFERENCE,
        "___recordID"                   REFERENCE,
        GRANT WRITE TO "_creator",
        GRANT CREATE TO "_icloud",
        GRANT READ TO "_world"
    );

    RECORD TYPE CD_SavedRoute (
        CD_actualDistanceMeters     DOUBLE QUERYABLE SORTABLE,
        CD_coordinatesData          BYTES QUERYABLE SORTABLE,
        CD_coordinatesData_ckAsset  ASSET,
        CD_createdAt                TIMESTAMP QUERYABLE SORTABLE,
        CD_entityName               STRING QUERYABLE SEARCHABLE SORTABLE,
        CD_estimatedDurationSeconds DOUBLE QUERYABLE SORTABLE,
        CD_id                       STRING QUERYABLE SEARCHABLE SORTABLE,
        CD_name                     STRING QUERYABLE SEARCHABLE SORTABLE,
        CD_requestedDistanceMeters  DOUBLE QUERYABLE SORTABLE,
        CD_routeTypeLegacy          STRING QUERYABLE SEARCHABLE SORTABLE,
        CD_routeTypeRaw             STRING QUERYABLE SEARCHABLE SORTABLE,
        CD_startLatitude            DOUBLE QUERYABLE SORTABLE,
        CD_startLongitude           DOUBLE QUERYABLE SORTABLE,
        CD_stepsData                BYTES QUERYABLE SORTABLE,
        CD_stepsData_ckAsset        ASSET,
        "___createTime"             TIMESTAMP,
        "___createdBy"              REFERENCE,
        "___etag"                   STRING,
        "___modTime"                TIMESTAMP,
        "___modifiedBy"             REFERENCE,
        "___recordID"               REFERENCE,
        GRANT WRITE TO "_creator",
        GRANT CREATE TO "_icloud",
        GRANT READ TO "_world"
    );

    RECORD TYPE CD_SavedWorkout (
        CD_createdAt             TIMESTAMP QUERYABLE SORTABLE,
        CD_entityName            STRING QUERYABLE SEARCHABLE SORTABLE,
        CD_id                    STRING QUERYABLE SEARCHABLE SORTABLE,
        CD_lastUsedAt            TIMESTAMP QUERYABLE SORTABLE,
        CD_name                  STRING QUERYABLE SEARCHABLE SORTABLE,
        CD_notes                 STRING QUERYABLE SEARCHABLE SORTABLE,
        CD_structureData         BYTES QUERYABLE SORTABLE,
        CD_structureData_ckAsset ASSET,
        CD_updatedAt             TIMESTAMP QUERYABLE SORTABLE,
        "___createTime"          TIMESTAMP,
        "___createdBy"           REFERENCE,
        "___etag"                STRING,
        "___modTime"             TIMESTAMP,
        "___modifiedBy"          REFERENCE,
        "___recordID"            REFERENCE,
        GRANT WRITE TO "_creator",
        GRANT CREATE TO "_icloud",
        GRANT READ TO "_world"
    );

    RECORD TYPE CD_ScheduledWorkout (
        CD_completedStrengthWorkout STRING QUERYABLE SEARCHABLE SORTABLE,
        CD_completedWorkout         STRING QUERYABLE SEARCHABLE SORTABLE,
        CD_customWorkoutName        STRING QUERYABLE SEARCHABLE SORTABLE,
        CD_entityName               STRING QUERYABLE SEARCHABLE SORTABLE,
        CD_healthKitPlanID          STRING QUERYABLE SEARCHABLE SORTABLE,
        CD_id                       STRING QUERYABLE SEARCHABLE SORTABLE,
        CD_intervalsData            BYTES QUERYABLE SORTABLE,
        CD_intervalsData_ckAsset    ASSET,
        CD_isCompleted              INT64 QUERYABLE SORTABLE,
        CD_linkedRunWorkoutID       STRING QUERYABLE SEARCHABLE SORTABLE,
        CD_linkedStrengthWorkoutID  STRING QUERYABLE SEARCHABLE SORTABLE,
        CD_notes                    STRING QUERYABLE SEARCHABLE SORTABLE,
        CD_scheduledDate            TIMESTAMP QUERYABLE SORTABLE,
        CD_strengthData             BYTES QUERYABLE SORTABLE,
        CD_strengthData_ckAsset     ASSET,
        CD_structureData            BYTES QUERYABLE SORTABLE,
        CD_structureData_ckAsset    ASSET,
        CD_targetDistanceMeters     DOUBLE QUERYABLE SORTABLE,
        CD_targetPaceLowerBound     DOUBLE QUERYABLE SORTABLE,
        CD_targetPaceUpperBound     DOUBLE QUERYABLE SORTABLE,
        CD_week                     STRING QUERYABLE SEARCHABLE SORTABLE,
        CD_workoutLocationLegacy    STRING QUERYABLE SEARCHABLE SORTABLE,
        CD_workoutLocationRaw       STRING QUERYABLE SEARCHABLE SORTABLE,
        CD_workoutTypeLegacy        STRING QUERYABLE SEARCHABLE SORTABLE,
        CD_workoutTypeRaw           STRING QUERYABLE SEARCHABLE SORTABLE,
        "___createTime"             TIMESTAMP,
        "___createdBy"              REFERENCE,
        "___etag"                   STRING,
        "___modTime"                TIMESTAMP,
        "___modifiedBy"             REFERENCE,
        "___recordID"               REFERENCE,
        GRANT WRITE TO "_creator",
        GRANT CREATE TO "_icloud",
        GRANT READ TO "_world"
    );

    RECORD TYPE CD_Shoe (
        CD_createdAt                 TIMESTAMP QUERYABLE SORTABLE,
        CD_defaultSetAt              TIMESTAMP QUERYABLE SORTABLE,
        CD_entityName                STRING QUERYABLE SEARCHABLE SORTABLE,
        CD_id                        STRING QUERYABLE SEARCHABLE SORTABLE,
        CD_name                      STRING QUERYABLE SEARCHABLE SORTABLE,
        CD_replacementDistanceMeters DOUBLE QUERYABLE SORTABLE,
        CD_retiredAt                 TIMESTAMP QUERYABLE SORTABLE,
        CD_startDate                 TIMESTAMP QUERYABLE SORTABLE,
        CD_startingDistanceMeters    DOUBLE QUERYABLE SORTABLE,
        "___createTime"              TIMESTAMP,
        "___createdBy"               REFERENCE,
        "___etag"                    STRING,
        "___modTime"                 TIMESTAMP,
        "___modifiedBy"              REFERENCE,
        "___recordID"                REFERENCE,
        GRANT WRITE TO "_creator",
        GRANT CREATE TO "_icloud",
        GRANT READ TO "_world"
    );

    RECORD TYPE CD_StrengthWorkout (
        CD_completedSetsData         BYTES QUERYABLE SORTABLE,
        CD_completedSetsData_ckAsset ASSET,
        CD_createdAt                 TIMESTAMP QUERYABLE SORTABLE,
        CD_date                      TIMESTAMP QUERYABLE SORTABLE,
        CD_durationSeconds           DOUBLE QUERYABLE SORTABLE,
        CD_entityName                STRING QUERYABLE SEARCHABLE SORTABLE,
        CD_healthKitWorkoutID        STRING QUERYABLE SEARCHABLE SORTABLE,
        CD_id                        STRING QUERYABLE SEARCHABLE SORTABLE,
        CD_linkedScheduledWorkoutID  STRING QUERYABLE SEARCHABLE SORTABLE,
        CD_notes                     STRING QUERYABLE SEARCHABLE SORTABLE,
        CD_scheduledWorkout          STRING QUERYABLE SEARCHABLE SORTABLE,
        "___createTime"              TIMESTAMP,
        "___createdBy"               REFERENCE,
        "___etag"                    STRING,
        "___modTime"                 TIMESTAMP,
        "___modifiedBy"              REFERENCE,
        "___recordID"                REFERENCE,
        GRANT WRITE TO "_creator",
        GRANT CREATE TO "_icloud",
        GRANT READ TO "_world"
    );

    RECORD TYPE CD_TrainingPlan (
        CD_createdAt            TIMESTAMP QUERYABLE SORTABLE,
        CD_customDistanceMeters DOUBLE QUERYABLE SORTABLE,
        CD_dueDate              TIMESTAMP QUERYABLE SORTABLE,
        CD_endDate              TIMESTAMP QUERYABLE SORTABLE,
        CD_entityName           STRING QUERYABLE SEARCHABLE SORTABLE,
        CD_goalTimeSeconds      DOUBLE QUERYABLE SORTABLE,
        CD_id                   STRING QUERYABLE SEARCHABLE SORTABLE,
        CD_isActive             INT64 QUERYABLE SORTABLE,
        CD_planKindRaw          STRING QUERYABLE SEARCHABLE SORTABLE,
        CD_raceDate             TIMESTAMP QUERYABLE SORTABLE,
        CD_raceName             STRING QUERYABLE SEARCHABLE SORTABLE,
        CD_startDate            TIMESTAMP QUERYABLE SORTABLE,
        CD_targetRaceLegacy     STRING QUERYABLE SEARCHABLE SORTABLE,
        CD_targetRaceRaw        STRING QUERYABLE SEARCHABLE SORTABLE,
        "___createTime"         TIMESTAMP,
        "___createdBy"          REFERENCE,
        "___etag"               STRING,
        "___modTime"            TIMESTAMP,
        "___modifiedBy"         REFERENCE,
        "___recordID"           REFERENCE,
        GRANT WRITE TO "_creator",
        GRANT CREATE TO "_icloud",
        GRANT READ TO "_world"
    );

    RECORD TYPE CD_TrainingWeek (
        CD_endDate          TIMESTAMP QUERYABLE SORTABLE,
        CD_entityName       STRING QUERYABLE SEARCHABLE SORTABLE,
        CD_id               STRING QUERYABLE SEARCHABLE SORTABLE,
        CD_phaseLegacy      STRING QUERYABLE SEARCHABLE SORTABLE,
        CD_phaseRaw         STRING QUERYABLE SEARCHABLE SORTABLE,
        CD_plan             STRING QUERYABLE SEARCHABLE SORTABLE,
        CD_startDate        TIMESTAMP QUERYABLE SORTABLE,
        CD_targetDistanceKm DOUBLE QUERYABLE SORTABLE,
        CD_weekNumber       INT64 QUERYABLE SORTABLE,
        "___createTime"     TIMESTAMP,
        "___createdBy"      REFERENCE,
        "___etag"           STRING,
        "___modTime"        TIMESTAMP,
        "___modifiedBy"     REFERENCE,
        "___recordID"       REFERENCE,
        GRANT WRITE TO "_creator",
        GRANT CREATE TO "_icloud",
        GRANT READ TO "_world"
    );

    RECORD TYPE CD_UserProfile (
        CD_age                                INT64 QUERYABLE SORTABLE,
        CD_bodyMassKilograms                  DOUBLE QUERYABLE SORTABLE,
        CD_createdAt                          TIMESTAMP QUERYABLE SORTABLE,
        CD_currentEstimated5KTimeSeconds      DOUBLE QUERYABLE SORTABLE,
        CD_customDistanceMeters               DOUBLE QUERYABLE SORTABLE,
        CD_dueDate                            TIMESTAMP QUERYABLE SORTABLE,
        CD_entityName                         STRING QUERYABLE SEARCHABLE SORTABLE,
        CD_fitnessLevelLegacy                 STRING QUERYABLE SEARCHABLE SORTABLE,
        CD_fitnessLevelRaw                    STRING QUERYABLE SEARCHABLE SORTABLE,
        CD_genderLegacy                       STRING QUERYABLE SEARCHABLE SORTABLE,
        CD_genderRaw                          STRING QUERYABLE SEARCHABLE SORTABLE,
        CD_goalFinishTime                     DOUBLE QUERYABLE SORTABLE,
        CD_goalRaceLegacy                     STRING QUERYABLE SEARCHABLE SORTABLE,
        CD_goalRaceRaw                        STRING QUERYABLE SEARCHABLE SORTABLE,
        CD_id                                 STRING QUERYABLE SEARCHABLE SORTABLE,
        CD_maxHeartRateBPM                    INT64 QUERYABLE SORTABLE,
        CD_name                               STRING QUERYABLE SEARCHABLE SORTABLE,
        CD_prePregnancyWeeklyRunMinutes       INT64 QUERYABLE SORTABLE,
        CD_preferredRunDayIndicesData         BYTES QUERYABLE SORTABLE,
        CD_preferredRunDayIndicesData_ckAsset ASSET,
        CD_pregnancyClearedAt                 TIMESTAMP QUERYABLE SORTABLE,
        CD_pregnancyHabituallyVigorous        INT64 QUERYABLE SORTABLE,
        CD_raceDate                           TIMESTAMP QUERYABLE SORTABLE,
        CD_raceName                           STRING QUERYABLE SEARCHABLE SORTABLE,
        CD_selectedEquipmentData              BYTES QUERYABLE SORTABLE,
        CD_selectedEquipmentData_ckAsset      ASSET,
        CD_strengthFocusRaw                   STRING QUERYABLE SEARCHABLE SORTABLE,
        CD_updatedAt                          TIMESTAMP QUERYABLE SORTABLE,
        CD_weeklyRunDays                      INT64 QUERYABLE SORTABLE,
        "___createTime"                       TIMESTAMP,
        "___createdBy"                        REFERENCE,
        "___etag"                             STRING,
        "___modTime"                          TIMESTAMP,
        "___modifiedBy"                       REFERENCE,
        "___recordID"                         REFERENCE,
        GRANT WRITE TO "_creator",
        GRANT CREATE TO "_icloud",
        GRANT READ TO "_world"
    );

    RECORD TYPE Cheer (
        "___createTime" TIMESTAMP,
        "___createdBy"  REFERENCE,
        "___etag"       STRING,
        "___modTime"    TIMESTAMP,
        "___modifiedBy" REFERENCE,
        "___recordID"   REFERENCE,
        payload         BYTES,
        GRANT WRITE TO "_creator",
        GRANT CREATE TO "_icloud",
        GRANT READ TO "_world"
    );

    RECORD TYPE FriendWeek (
        "___createTime" TIMESTAMP,
        "___createdBy"  REFERENCE,
        "___etag"       STRING,
        "___modTime"    TIMESTAMP,
        "___modifiedBy" REFERENCE,
        "___recordID"   REFERENCE,
        payload         BYTES,
        weekStart       STRING,
        GRANT WRITE TO "_creator",
        GRANT CREATE TO "_icloud",
        GRANT READ TO "_world"
    );

    RECORD TYPE Users (
        "___createTime" TIMESTAMP,
        "___createdBy"  REFERENCE,
        "___etag"       STRING,
        "___modTime"    TIMESTAMP,
        "___modifiedBy" REFERENCE,
        "___recordID"   REFERENCE QUERYABLE,
        roles           LIST<INT64>,
        GRANT WRITE TO "_creator",
        GRANT READ TO "_world"
    );

    RECORD TYPE "cloudkit.share" (
        "___createTime"               TIMESTAMP,
        "___createdBy"                REFERENCE,
        "___etag"                     STRING,
        "___modTime"                  TIMESTAMP,
        "___modifiedBy"               REFERENCE,
        "___recordID"                 REFERENCE,
        "cloudkit.thumbnailImageData" BYTES,
        "cloudkit.title"              STRING,
        "cloudkit.type"               STRING,
        GRANT WRITE TO "_creator",
        GRANT CREATE TO "_icloud",
        GRANT READ TO "_world"
    );
