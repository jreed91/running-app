<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
    <!--
        Route Genius uses OpenRouteService (https://openrouteservice.org) for route generation.

        Setup:
          1. Create a free account at https://openrouteservice.org
          2. Generate a token from your dashboard (free tier: 2,000 req/day)
          3. Copy this file to RunningApp/Resources/Secrets.plist  (do NOT commit that file)
          4. Replace the placeholder below with your token
          5. Re-run `xcodegen generate` if needed
    -->
    <key>ORSAPIKey</key>
    <string>YOUR_ORS_API_KEY_HERE</string>

    <!--
        Strava sync uploads completed runs as GPS activities via the Strava v3 API.

        Setup:
          1. Create an API application at https://www.strava.com/settings/api
          2. Set the "Authorization Callback Domain" to: stride
          3. Copy the Client ID and Client Secret into the keys below
          4. Copy this file to Stride/Resources/Secrets.plist  (do NOT commit that file)

        Leaving the placeholders in place hides the Strava option in Settings.
    -->
    <key>StravaClientID</key>
    <string>YOUR_STRAVA_CLIENT_ID_HERE</string>
    <key>StravaClientSecret</key>
    <string>YOUR_STRAVA_CLIENT_SECRET_HERE</string>
</dict>
</plist>
