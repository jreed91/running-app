# Generated Xcode project — recreated from project.yml via `xcodegen generate`
*.xcodeproj/
*.xcworkspace/

# Generated by XcodeGen from the `info:` / `entitlements:` properties in project.yml.
# Committing them created two sources of truth: hand-edits here were silently
# overwritten on the next `xcodegen generate`. Edit project.yml instead.
Stride/Resources/Info.plist
Stride/Resources/Stride.entitlements

